# Installed as /etc/sentinel/sentinel.conf with mode 0600.
# Keep the bot token out of this file; it belongs in telegram-token.
TELEGRAM_CHAT_ID=

# What this Sentinel watches: boinc (option 1), process (option 2),
# docker (option 3) or resource (option 4), or several comma-separated,
# e.g. boinc,process,resource.
# install.sh appends this line; a missing value means boinc.
# SENTINEL_MONITOR=boinc

# Common settings and their defaults.
# ALERT_AFTER_FAILURES=2
# REMINDER_HOURS=12
# STATE_FILE=/var/lib/sentinel/state.json
# COMMAND_TIMEOUT=8

# Auto-recovery for options 1 to 3. RECOVER_ENABLED=0 turns it off.
# RECOVER_ENABLED=1
# RECOVER_AFTER_FAILURES=1
# RECOVER_COOLDOWN_HOURS=6
# RECOVER_MAX_PER_INCIDENT=2
# RECOVER_TIMEOUT=45
#
# boinc: on a work shortage Sentinel runs `boinccmd --acct_mgr sync` to make the
# account manager hand out projects again. That call is destructive: the
# manager may reply <detach/>, which BOINC acts on immediately and which
# discards whatever the detached project had in flight. The cooldown is what
# keeps one detach from cascading into the next check's failure, so lower it
# with care.
#
# process: a service target in ActiveState=failed gets `systemctl reset-failed`
# and `systemctl restart`. The cooldown and the per-incident budget apply per
# target. The restart needs the sentinel.service.d/restart.conf drop-in; rerun
# install.sh after changing RECOVER_ENABLED so the drop-in follows it.
#
# docker: a crashed container gets `start`, an unhealthy one `restart`,
# through the Engine API. No extra privilege is needed.

# Option 1 (boinc) only. The defaults match the Osaka A1.Flex instance.
# TOTAL_VCPUS=2
# SAMPLE_SECONDS=10
# CPU_THRESHOLD=30
# BOINC_SERVICE=boinc-client.service
# BOINCCMD=/usr/bin/boinccmd
# BOINC_DATA_DIR=/var/lib/boinc-client
# CGROUP_ROOT=/sys/fs/cgroup

# Options 2 and 3 (process, docker).
# TARGETS_FILE=/etc/sentinel/targets

# Option 3 (docker) only.
# DOCKER_SOCKET=/var/run/docker.sock

# Option 4 (resource). A target fails while its reading is over the limit and
# alerts after ALERT_AFTER_FAILURES checks in a row; nothing is recovered
# automatically. 0 turns a target off. Check a change with
# `sudo /usr/local/sbin/sentinel check-config`.
#
# CPU and the transmit rate are averages over the time since the previous run
# (15 minutes with boinc, 5 minutes without).
#
# CPU percent of all vCPUs, not counting nice processes such as BOINC tasks.
# RESOURCE_CPU_MAX=90
# Memory in use, from MemAvailable.
# RESOURCE_MEMORY_MAX=90
# Disk in use, the Use% of df, for each comma-separated path. Paths under
# /home, /root and /run/user are refused: the unit cannot see them.
# RESOURCE_DISK_MAX=90
# RESOURCE_DISK_PATHS=/
#
# Outbound traffic. Empty picks the interface of the IPv4 default route.
# RESOURCE_NET_INTERFACE=
# Average transmit rate in Mbit/s. The defaults follow Oracle Cloud's Always
# Free allowance of 10 TB of outbound data per month: 30 Mbit/s kept up for a
# whole month is about 10 TB.
# RESOURCE_NET_TX_MBPS=30
# Outbound total of the calendar month (UTC) in GB, counted by Sentinel since
# it was installed. 8000 is 80% of the 10 TB. Other instances of the tenancy
# are not counted.
# RESOURCE_NET_MONTH_TX_GB=8000
